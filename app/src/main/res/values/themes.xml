<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BlockUnknownCalls" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>

    <style name="Theme.BlockUnknownCalls" parent="Base.Theme.BlockUnknownCalls" />

    <style name="SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="ListCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
